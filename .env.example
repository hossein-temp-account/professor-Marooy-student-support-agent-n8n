# --- MySQL ---
MYSQL_ROOT_PASSWORD=replace-me-root
MYSQL_DATABASE=support_agent
MYSQL_USER=support_app
MYSQL_PASSWORD=replace-me-app

# --- n8n ---
N8N_ENCRYPTION_KEY=replace-me-48-byte-base64
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# --- OpenRouter ---
# Reminder only. The real key lives in n8n's credential store,
# set through the UI as a Header Auth credential. Never reference
# this var from a node -- N8N_BLOCK_ENV_ACCESS_IN_NODE is on.
OPENROUTER_API_KEY=

# --- Knowledge-match threshold ---
# NOTE: this variable is NOT read by n8n (N8N_BLOCK_ENV_ACCESS_IN_NODE is
# on). The real values are constants at the top of the "Build Answer
# Context" Code node: KB_MATCH_THRESHOLD (min MySQL fulltext relevance,
# default 0.05) and MIN_CLASS_CONFIDENCE (default 0.3). Kept here only as
# documentation. See n8n/BUILD.md.
KB_MATCH_THRESHOLD=0.05

# --- Admin panel (/admin) ---
# Single admin account, checked directly against these values --
# no user table, no signup. Change the password to something real
# before you expose this anywhere beyond your own machine.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-admin-password
# Random secret used to sign admin login sessions (JWT). Generate
# one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-me-64-char-random-hex
